# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this to .env and fill in real values. NEVER commit .env.

# ---- Server ----
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://trader:trader@localhost:5432/trading
DB_SSL=false

# ---- Encryption (AES-256-GCM for broker credentials at rest) ----
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
ENCRYPTION_IV=CHANGE_ME_12_BYTE_BASE64_IV

# ---- WebSocket ----
WS_HEARTBEAT_MS=30000
MARKET_DATA_STALE_MS=10000

# ---- Risk Defaults (overridden per user / per asset in DB) ----
DEFAULT_RISK_PER_TRADE=0.005
DEFAULT_MAX_DAILY_LOSS=0.02
DEFAULT_MAX_WEEKLY_LOSS=0.05
DEFAULT_MAX_DRAWDOWN=0.10
DEFAULT_MAX_CONSECUTIVE_LOSSES=3
DEFAULT_MAX_OPEN_POSITIONS=3
DEFAULT_MAX_EXPOSURE=0.10
DEFAULT_MIN_MARGIN_LEVEL=150

# ---- MT5 Bridge (list of bridges users can connect through) ----
# Operators can run multiple bridges; user specifies bridge URL at connect.
MT5_BRIDGE_SECRET=CHANGE_ME

# ---- Exchange API keys are stored encrypted per-user in DB; no global keys ----

# ---- Logging ----
LOG_LEVEL=info
LOG_FILE=./logs/trading.log

# ---- Emergency ----
EMERGENCY_CLOSE_ALL_BY_DEFAULT=false
